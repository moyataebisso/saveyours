# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== App =====
# Public base URL for links we put in emails (reschedule links, admin alerts).
# No trailing slash.
NEXT_PUBLIC_APP_URL=https://saveyours.net
NEXT_PUBLIC_SITE_NAME=SaveYours

# ===== Email (Gmail SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=info@saveyours.net
EMAIL_PASS=

# ===== Admin session signing =====
# Min 32 chars. Rotating this logs every admin out.
ADMIN_SESSION_SECRET=

# ===== Payment-ownership cookie signing =====
# Min 32 chars. Rotating invalidates in-flight checkout sessions.
PI_COOKIE_SECRET=

# ===== Reschedule token signing =====
# Min 32 chars. Signs the 7-day self-serve reschedule link that goes into
# the enrollment confirmation email and the /reschedule flow. Rotating this
# instantly invalidates every outstanding reschedule link.
RESCHEDULE_TOKEN_SECRET=

# ===== Arsi Platform Supabase (change requests only) =====
ARSI_SUPABASE_URL=
ARSI_SUPABASE_SERVICE_KEY=

# ===== Resend (change-request notifications) =====
RESEND_API_KEY=
RESEND_FROM_EMAIL=
